@model List<BrandListItem>
@{
    ViewData["Title"] = "Marcas";
}
<h1 class="h3 mb-1">Marcas</h1>
<p class="text-secondary">
    @User.FindFirst(OrgClaims.OrganizationName)?.Value · El perfil de cada marca se reutiliza en todas sus campañas.
</p>

@if (User.CanEdit())
{
    <form asp-action="Create" method="post" class="row g-2 align-items-end mb-4">
        <div class="col-md-5">
            <label for="Name" class="form-label small">Nombre de la marca nueva</label>
            <input type="text" class="form-control" id="Name" name="Name" maxlength="150" required />
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-primary">Crear marca</button></div>
    </form>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Marca</th><th>Productos</th><th>Mensajes prohibidos</th><th>Briefs</th></tr></thead>
            <tbody>
                @foreach (BrandListItem brand in Model)
                {
                    <tr>
                        <td><a asp-action="Detail" asp-route-id="@brand.Id">@brand.Name</a></td>
                        <td>@brand.Products</td>
                        <td>@brand.ForbiddenMessages</td>
                        <td>@brand.Briefs</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <div class="card-body text-secondary">Todavía no hay marcas.</div>
    }
</div>
