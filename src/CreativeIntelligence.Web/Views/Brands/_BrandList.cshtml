@model BrandListViewModel
@* Una de las listas del perfil de una marca: sus elementos y el formulario para agregar uno. *@
<div class="card h-100" data-brand-list="@Model.Kind">
    <div class="card-body">
        <h2 class="h6 mb-0">@Model.Title</h2>
        <p class="small text-secondary">@Model.Hint</p>
        <ul class="list-group list-group-flush mb-3">
            @foreach (BrandItemView item in Model.Items)
            {
                <li class="list-group-item d-flex justify-content-between align-items-start gap-2 px-0">
                    <span>
                        @item.Text
                        @if (item.MarginPercent is not null)
                        {
                            <span class="badge text-bg-light border">margen @item.MarginPercent.Value.ToString("0.##") %</span>
                        }
                        @if (item.Detail is not null)
                        {
                            <span class="d-block small text-secondary">@item.Detail</span>
                        }
                    </span>
                    @if (Model.CanEdit)
                    {
                        <form asp-action="RemoveItem" asp-route-id="@item.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Quitar">×</button>
                        </form>
                    }
                </li>
            }
            @if (Model.Items.Count == 0)
            {
                <li class="list-group-item px-0 text-secondary small">Sin cargar.</li>
            }
        </ul>
        @if (Model.CanEdit)
        {
            <form asp-action="AddItem" asp-route-id="@Model.BrandId" method="post" class="row g-2">
                <input type="hidden" name="Kind" value="@Model.Kind" />
                <div class="@(Model.Kind == BrandItemKind.Product ? "col-8" : "col-12")">
                    <input type="text" class="form-control form-control-sm" name="Text" maxlength="300" placeholder="@Model.TextLabel" aria-label="@Model.TextLabel" required />
                </div>
                @if (Model.Kind == BrandItemKind.Product)
                {
                    <div class="col-4">
                        <input type="number" class="form-control form-control-sm" name="MarginPercent" min="0" max="100" step="0.01" placeholder="Margen %" aria-label="Margen %" />
                    </div>
                }
                @if (Model.DetailLabel is not null)
                {
                    <div class="col-12">
                        <input type="text" class="form-control form-control-sm" name="Detail" maxlength="1000" placeholder="@Model.DetailLabel (opcional)" aria-label="@Model.DetailLabel" />
                    </div>
                }
                <div class="col-12"><button type="submit" class="btn btn-sm btn-outline-primary">Agregar</button></div>
            </form>
        }
    </div>
</div>
