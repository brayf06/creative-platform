@model List<RecipeListItem>
@{
    ViewData["Title"] = "Recetas";
}
<div class="d-flex justify-content-between align-items-start mb-1">
    <h1 class="h3 mb-0">Recetas</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-action="Videos">Videos generados</a>
        <a class="btn btn-outline-secondary" asp-controller="Batches" asp-action="Index">Lotes</a>
        @if (User.CanEdit())
        {
            <a class="btn btn-primary" asp-action="Create">Nueva receta</a>
        }
    </div>
</div>
<p class="text-secondary">
    @User.FindFirst(OrgClaims.OrganizationName)?.Value · Una receta dice qué fragmentos se unen y en qué formato; de cada
    receta se generan videos.
</p>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Receta</th><th>Formato</th><th>Fragmentos</th><th>Duración</th><th>Videos generados</th><th>Creada (UTC)</th></tr></thead>
            <tbody>
                @foreach (RecipeListItem recipe in Model)
                {
                    <tr>
                        <td><a asp-action="Detail" asp-route-id="@recipe.Id">@recipe.Name</a></td>
                        <td class="text-nowrap">@recipe.Width×@recipe.Height</td>
                        <td>@recipe.Items</td>
                        <td class="text-nowrap">@Formatting.Duration(recipe.DurationMs)</td>
                        <td>@recipe.ReadyVariants de @recipe.Variants</td>
                        <td class="text-nowrap">@recipe.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <div class="card-body text-secondary">
            Todavía no hay recetas. Para armar una, primero elegí fragmentos "para producción" en el detalle de un video
            con autorización de reutilización.
        </div>
    }
</div>
