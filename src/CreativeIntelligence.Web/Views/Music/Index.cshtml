@model List<MusicTrackItem>
@{
    ViewData["Title"] = "Música";
    string accept = string.Join(",", MusicService.Extensions);
}
<nav class="small mb-2"><a asp-controller="Media" asp-action="Index">Biblioteca</a> / Música</nav>
<h1 class="h3 mb-1">Música</h1>
<p class="text-secondary">
    @User.FindFirst(OrgClaims.OrganizationName)?.Value · Pistas para usar de fondo. Sólo una pista con autorización
    vigente puede entrar en una receta.
</p>

@if (User.CanEdit())
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h6">Cargar una pista</h2>
            <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-3">
                <div class="col-md-5">
                    <label for="File" class="form-label small">Archivo de audio (@string.Join(" ", MusicService.Extensions))</label>
                    <input type="file" class="form-control" id="File" name="File" accept="@accept" required />
                </div>
                <div class="col-md-4">
                    <label for="Name" class="form-label small">Nombre (opcional)</label>
                    <input type="text" class="form-control" id="Name" name="Name" maxlength="200" />
                </div>
                <div class="col-md-3">
                    <label for="RightsHolder" class="form-label small">Titular de los derechos</label>
                    <input type="text" class="form-control" id="RightsHolder" name="RightsHolder" maxlength="200" />
                </div>
                <div class="col-md-6">
                    <label for="LicenseNotes" class="form-label small">Licencia y restricciones</label>
                    <input type="text" class="form-control" id="LicenseNotes" name="LicenseNotes" maxlength="1000" />
                </div>
                <div class="col-md-3">
                    <label for="RightsExpireOn" class="form-label small">Autorización vigente hasta</label>
                    <input type="date" class="form-control" id="RightsExpireOn" name="RightsExpireOn" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="ReuseAuthorized" name="ReuseAuthorized" value="true" />
                        <label for="ReuseAuthorized" class="form-check-label">Autorizada para usar en anuncios</label>
                    </div>
                </div>
                <div class="col-12"><button type="submit" class="btn btn-primary">Cargar</button></div>
            </form>
        </div>
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Pista</th><th>Duración</th><th>Estado</th><th>Derechos</th><th>Titular y licencia</th><th></th></tr></thead>
            <tbody>
                @foreach (MusicTrackItem track in Model)
                {
                    <tr data-status="@track.Status">
                        <td>@track.Name <span class="d-block small text-secondary">@track.FileName</span></td>
                        <td class="text-nowrap">@Formatting.Duration(track.DurationMs)</td>
                        <td>
                            @if (track.Status == MediaProcessingStatus.Ready)
                            {
                                <span class="badge text-bg-success">Lista</span>
                            }
                            else if (track.Status == MediaProcessingStatus.Failed)
                            {
                                <span class="badge text-bg-danger" title="@track.Error">Ilegible</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Analizando…</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(track.ReuseAuthorized ? "text-bg-success" : "text-bg-secondary")">@(track.ReuseAuthorized ? "Autorizada" : "Sin autorización")</span>
                            @if (track.RightsExpireOn is not null)
                            {
                                <span class="small text-secondary">hasta @track.RightsExpireOn.Value.ToString("yyyy-MM-dd")</span>
                            }
                        </td>
                        <td class="small">@track.RightsHolder <span class="d-block text-secondary">@track.LicenseNotes</span></td>
                        <td class="text-end">
                            @if (User.CanEdit())
                            {
                                <form asp-action="Authorize" asp-route-id="@track.Id" method="post">
                                    <input type="hidden" name="authorized" value="@(track.ReuseAuthorized ? "false" : "true")" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@(track.ReuseAuthorized ? "Quitar autorización" : "Autorizar")</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <div class="card-body text-secondary">Todavía no hay pistas.</div>
    }
</div>

@section Scripts {
    <script>
        // Mientras haya una pista analizándose, la página se vuelve a pedir sola.
        if (document.querySelector('[data-status="Pending"]')) { setTimeout(function () { location.reload(); }, 3000); }
    </script>
}
