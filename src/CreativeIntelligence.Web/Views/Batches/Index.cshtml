@model List<BatchListItem>
@{
    ViewData["Title"] = "Lotes";
}
<div class="d-flex justify-content-between align-items-start mb-1">
    <h1 class="h3 mb-0">Lotes de creatividades</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-controller="Recipes" asp-action="Index">Recetas</a>
        @if (User.CanEdit())
        {
            <a class="btn btn-primary" asp-action="Create">Nuevo lote</a>
        }
    </div>
</div>
<p class="text-secondary">
    @User.FindFirst(OrgClaims.OrganizationName)?.Value · Un lote genera de 5 a 50 variantes distintas a partir de un
    mismo conjunto de fragmentos.
</p>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Lote</th><th>Variantes</th><th>Avance</th><th>Creado (UTC)</th></tr></thead>
            <tbody>
                @foreach (BatchListItem batch in Model)
                {
                    <tr>
                        <td><a asp-action="Detail" asp-route-id="@batch.Id">@batch.Name</a></td>
                        <td>@batch.Total de @batch.RequestedCount pedidas</td>
                        <td>
                            @batch.Ready listos
                            @if (batch.Failed > 0)
                            {
                                <span class="badge text-bg-danger">@batch.Failed con error</span>
                            }
                            @if (batch.Ready + batch.Failed < batch.Total)
                            {
                                <span class="badge text-bg-secondary">@(batch.Total - batch.Ready - batch.Failed) en cola</span>
                            }
                        </td>
                        <td class="text-nowrap">@batch.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <div class="card-body text-secondary">Todavía no hay lotes.</div>
    }
</div>
