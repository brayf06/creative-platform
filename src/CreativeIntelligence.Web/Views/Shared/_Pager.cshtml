@model PagerViewModel
<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-secondary small">@Model.Total registros · página @Model.Page de @Model.TotalPages</span>
    <div class="btn-group">
        <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" asp-action="Index" asp-all-route-data="@(Model.Route ?? [])" asp-route-Page="@(Model.Page - 1)">Anterior</a>
        <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-action="Index" asp-all-route-data="@(Model.Route ?? [])" asp-route-Page="@(Model.Page + 1)">Siguiente</a>
    </div>
</div>
